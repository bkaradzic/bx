						<Exec>ii += 8</Exec>
					</If>
					<Else>
						<If Condition="(m_control.m_control[ii] &amp; 0x80) == 0">
							<Item Name="[{(($T1*)m_control.m_keys)[ii]}]">(($T2*)(m_values.m_blocks.m_term - m_values.m_blocks.m_blk.size / sizeof(*m_values.m_blocks.m_term))[m_control.m_slots[ii] &gt;&gt; m_values.m_blockShift].ptr)[m_control.m_slots[ii] &amp; (m_values.m_blockCapacity - 1)]</Item>
						</If>
						<Exec>ii++</Exec>
					</Else>
				</Loop>
			</CustomListItems>
		</Expand>
	</Type>

